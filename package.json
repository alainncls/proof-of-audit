{
  "name": "proof-of-audit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "prettier --check '**/*.css' '**/*.ts' '**/*.tsx' '**/*.json' '**/*.md'",
    "format:fix": "prettier --write '**/*.css' '**/*.ts' '**/*.tsx' '**/*.json' '**/*.md'",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "security:verify": "node --experimental-strip-types scripts/verify-security-fixes.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "5.104.1",
    "@verax-attestation-registry/verax-sdk": "5.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@base-org/account": "2.5.13",
    "@graphql-tools/utils": "12.0.3",
    "@fastify/busboy": "3.2.2",
    "@graphql-tools/executor-legacy-ws": "1.1.37",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": "24.18.0"
  }
}
