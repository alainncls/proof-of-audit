{
  "name": "proof-of-audit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "prettier --check '**/*.css' '**/*.ts' '**/*.tsx' '**/*.mjs' '**/*.json' '**/*.md'",
    "format:fix": "prettier --write '**/*.css' '**/*.ts' '**/*.tsx' '**/*.mjs' '**/*.json' '**/*.md'",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test:browser:wallet": "node scripts/wallet-chunk-retry-smoke.mjs",
    "test:browser:wallet:missing-config": "node scripts/wallet-chunk-retry-smoke.mjs --expect-missing-config",
    "security:verify": "node --experimental-strip-types scripts/verify-security-fixes.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "5.104.5",
    "@verax-attestation-registry/verax-sdk": "5.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.11",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
